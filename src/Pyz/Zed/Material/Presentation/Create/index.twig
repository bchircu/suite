{% extends '@Gui/Layout/layout.twig' %}

{% set widget_title = 'Create Material' | trans %}

{% block head_title widget_title %}
{% block section_title widget_title %}

{% block content %}

    {% embed '@Gui/Partials/widget.twig' %}

        {% block widget_content %}

            {{ form_start(materialCreateForm) }}

            {{ form_row(materialCreateForm.name) }}

            <input type="submit" class="btn btn-primary safe-submit" value="{{ 'Save' | trans }}" />
            <a href="{{ backUrl }}" class="btn btn-back">{{ 'Cancel' | trans }}</a>

            {{ form_end(materialCreateForm) }}

        {% endblock %}

    {% endembed %}

{% endblock %}
