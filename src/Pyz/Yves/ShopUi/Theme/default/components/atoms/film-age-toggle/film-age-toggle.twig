{% extends model('component') %}

{% define config = {
    name: 'film-age-toggle',
    tag: 'film-age-toggle',
} %}

{% define data = {
    releaseDate: required,
} %}

{% define attributes = {
    'data-release-date': data.releaseDate,
} %}

{% block body %}
    <span class="{{ config.name }}__date-display">{{ data.releaseDate }}</span>
    <button type="button" class="{{ config.name }}__toggle-button" title="{{ 'Click to toggle between date and age' | trans }}">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm1 12H7V7h2v5zm0-6H7V4h2v2z"/>
        </svg>
    </button>
{% endblock %}
